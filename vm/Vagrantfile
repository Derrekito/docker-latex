# VirtualBox VM with the same LaTeX toolchain as the Docker image.
#
#   cd vm && vagrant up      # first boot provisions everything (TeX Live full takes a while)
#   vagrant ssh              # your documents are at /app
#
# Environment overrides:
#   LATEX_DIR       host directory mounted at /app (default: repo root)
#   VM_MEMORY       MB of RAM (default: 4096)
#   VM_CPUS         CPU count (default: 2)
#   TEXLIVE_SCHEME  e.g. scheme-medium for a smaller install (default: scheme-full)

Vagrant.configure("2") do |config|
  config.vm.box = "bento/debian-13"
  config.vm.hostname = "latex-environment"

  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder ENV.fetch("LATEX_DIR", File.expand_path("..", __dir__)), "/app"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "latex-environment"
    vb.memory = ENV.fetch("VM_MEMORY", "4096").to_i
    vb.cpus = ENV.fetch("VM_CPUS", "2").to_i
  end

  # Theme and Pygments sources from this repo, used by provision.sh
  config.vm.provision "file", source: File.expand_path("../texmf", __dir__), destination: "/tmp/docker-latex-assets/texmf"
  config.vm.provision "file", source: File.expand_path("../python", __dir__), destination: "/tmp/docker-latex-assets/python"

  config.vm.provision "shell",
    path: "provision.sh",
    env: { "TEXLIVE_SCHEME" => ENV.fetch("TEXLIVE_SCHEME", "scheme-full") }
end
